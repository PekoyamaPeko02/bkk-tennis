{
  "name": "@bkk/player",
  "version": "0.1.0",
  "productName": "BKK Tennis",
  "private": true,
  "description": "BKK Tennis \u2014 player app (web, PWA, iOS/Android via Capacitor)",
  "type": "module",
  "scripts": {
    "postinstall": "quasar prepare",
    "dev": "quasar dev",
    "dev:api": "cross-env API_MOCK=false API_BASE=http://localhost:5080 quasar dev",
    "build": "quasar build",
    "build:pwa": "quasar build -m pwa",
    "typecheck": "quasar prepare && vue-tsc --noEmit"
  },
  "dependencies": {
    "@bkk/api": "workspace:*",
    "@bkk/ui": "workspace:*",
    "@microsoft/signalr": "^8.0.17",
    "@quasar/extras": "^1.17.0",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "quasar": "^2.18.6",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@quasar/app-vite": "^2.4.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.0.0",
    "typescript": "~5.9.3",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": "^22 || ^24",
    "pnpm": ">= 9"
  }
}
